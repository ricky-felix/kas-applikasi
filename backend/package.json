{
  "name": "kas-applikasi-backend",
  "version": "0.2.0",
  "private": true,
  "description": "kas-applikasi API — Python/FastAPI port (see README.md). Legacy NestJS output remains in dist/.",
  "scripts": {
    "start": "uvicorn app.main:app --host 0.0.0.0 --port 3001",
    "dev": "uvicorn app.main:app --host 0.0.0.0 --port 3001 --reload",
    "generate": "python -m prisma generate --schema prisma/schema.prisma",
    "start:legacy-nestjs": "node dist/main.js"
  }
}
